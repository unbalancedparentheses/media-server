# ─── General ────────────────────────────────────────────────────
# Top-level keys must come before the first [section] in TOML

timezone = "America/New_York"

# ─── Credentials ─────────────────────────────────────────────────

[jellyfin]
username = "admin"
password = "changeme"

[qbittorrent]
username = "admin"
password = "changeme"

[downloads]
seeding_ratio = 2
seeding_time_minutes = 10080
upload_limit_kib = 100   # qBittorrent upload cap in KiB/s (0 = no limit)

[subtitles]
languages = ["en", "es"]
# "first": English (the first language); until it's found, the others are
#          fetched too as a fallback; "all": get every language
want = "first"
providers = [
  # No account needed
  "yifysubtitles",     # Great for movies
  "tvsubtitles",       # TV-focused provider
  "gestdown",          # Good general coverage
  "supersubtitles",    # Broad coverage
  "subtitlecat",       # Large catalog (some machine-translated)
  "embeddedsubtitles", # Uses subs already in the file (most anime releases)
  "subtitulamostv",    # English and Spanish TV subtitles
  "subtis",            # Spanish movie subtitles, matched by file
  # Need an account or API key: add it in Bazarr (Settings → Providers),
  # then uncomment. Enabled without one, Bazarr pauses them for 12 hours.
  # "opensubtitlescom",  # Largest database (free account at opensubtitles.com)
  # "subdl",             # Large database (free API key at subdl.com)
  # "jimaku",            # Anime, Japanese and English (free API key at jimaku.cc)
  # "addic7ed",          # Curated TV subtitles
  # "subx",              # Largest Spanish/Latin American catalog, ex-Subdivx (free API key)
  # "animetosho",        # Anime subs from fansub releases (needs an AniDB API client in Bazarr → Settings → Anime)
]

# ─── Quality ───────────────────────────────────────────────────
# The profiles a fresh Sonarr/Radarr ships with; Seerr requests use them.
# Supported names: "Any", "SD", "HD-720p", "HD-1080p", "Ultra-HD",
# "HD - 720p/1080p". Junk releases (BR-DISK, LQ, upscaled, extras, 3D) are
# blocked in every profile; see custom-formats/README.md.

[quality]
sonarr_profile = "HD-1080p"
sonarr_anime_profile = "HD-1080p"   # for anime (goes to ~/media/anime)
radarr_profile = "HD-1080p"
prefer_h265 = true    # prefer x265/HEVC releases (smaller files, same quality)
rename_files = true   # name files "Show - S01E01 - Title", "Movie (Year)" so Jellyfin matches them
prefer_english_audio = true   # movies and TV: prefer releases with English audio
anime_block_dubs = true       # anime: never grab English-dub-only releases
                              # (Japanese audio + subtitles; dual audio is fine)
anime_release_groups = true   # anime: prefer well-rated release groups (TRaSH tiers)

# ─── Playback (Jellyfin user defaults) ──────────────────────────
# subtitle_mode: "Always", "Smart" (only when the audio isn't your
#   language), "OnlyForced", "Default" or "None".
# subtitle_language / audio_language: 3-letter codes. audio_language is
#   used when a file has that track (dual-audio anime → Japanese); other
#   files play their default track. "" = always the default track.

[playback]
subtitle_mode = "Always"
subtitle_language = "eng"
audio_language = "jpn"
hardware_acceleration = true   # convert video with Apple's hardware (VideoToolbox) when a device needs it
allow_remux = false            # false: devices that can't play a file get it converted, not copied (browsers can stall on copied Blu-ray video)

# ─── Requests (Seerr) ───────────────────────────────────────────
# auto_approve: requests from other users (family members signing in with
#   their own Jellyfin account) download right away; false = they wait for
#   your approval in Seerr. Your own requests are always approved.

[requests]
auto_approve = true

# ─── Network ────────────────────────────────────────────────────
# admin_bind: address the admin UIs (Sonarr, Radarr, Prowlarr, Bazarr,
#   qBittorrent, SABnzbd) listen on: "0.0.0.0" = every interface (LAN +
#   Tailscale) or "127.0.0.1" = this Mac only. Jellyfin/Moonfin, Seerr and
#   the dashboard are always reachable.
# dashboard_port: port of the dashboard (http://localhost by default).
# tailscale_https: if Tailscale is signed in, publish Jellyfin/Moonfin,
#   Seerr and the dashboard over HTTPS on your tailnet.

[network]
admin_bind = "0.0.0.0"
dashboard_port = 80
tailscale_https = true

# ─── Disk space ────────────────────────────────────────────────
# warn_free_gb: show a macOS notification when free space on the media disk
#   drops below this (checked every 30 minutes, at most one warning per 6h).
# min_free_gb: Sonarr/Radarr stop importing below this, so the disk never
#   fills up completely.

[disk]
warn_free_gb = 50
min_free_gb = 10

# ─── Stuck downloads (Cleanuparr) ────────────────────────────────
# Every 5 minutes Cleanuparr checks the download queue and removes public
# torrents that stalled (no progress for stalled_strikes checks), never got
# metadata, or failed to import 3 times. Sonarr/Radarr blocklist the release
# and search for another one.

[cleanuparr]
enabled = true
stalled_strikes = 6   # 6 checks x 5 minutes = about 30 minutes stalled

# After each download is imported, its file is checked and fixed
[library]
check_downloads = true    # replace downloads that won't play, are far too short (samples,
                          # fakes) or are dubbed anime (with quality.anime_block_dubs)
max_replacements = 3      # other releases tried before keeping the file and telling you
stereo_audio = true       # add a stereo track browsers play directly when the audio is only
                          # Dolby/DTS, so nothing has to be converted while you watch
ocr_subtitles = true      # read Blu-ray picture subtitles into text .srt files

# ─── Indexers (Prowlarr) ───────────────────────────────────────

[[indexers]]
name = "1337x"
definitionName = "1337x"
enable = true
flaresolverr = true   # needs Byparr to get past Cloudflare

[[indexers]]
name = "EZTV"
definitionName = "eztv"
enable = true

[[indexers]]
name = "The Pirate Bay"
definitionName = "thepiratebay"
enable = true

[[indexers]]
name = "YTS"
definitionName = "yts"
enable = true

[[indexers]]
name = "Knaben"
definitionName = "Knaben"
enable = true

[[indexers]]
name = "LimeTorrents"
definitionName = "limetorrents"
enable = true

[[indexers]]
name = "MegaPeer"
definitionName = "megapeer"
enable = true
flaresolverr = true   # behind Cloudflare

[[indexers]]
name = "Nyaa.si"
definitionName = "nyaasi"
enable = true

[[indexers]]
name = "SubsPlease"
definitionName = "SubsPlease"
enable = true

[[indexers]]
name = "Mikan"
definitionName = "mikan"
enable = true

[[indexers]]
name = "Bangumi Moe"
definitionName = "bangumi-moe"
enable = true

[[indexers]]
name = "KickassTorrents"
definitionName = "kickasstorrents-to"
enable = true
flaresolverr = true   # behind Cloudflare

[[indexers]]
name = "Uindex"
definitionName = "uindex"
enable = true
flaresolverr = true   # behind Cloudflare

[[indexers]]
name = "Tokyo Toshokan"
definitionName = "tokyotosho"
enable = true

[[indexers]]
name = "nekoBT"
definitionName = "nekobt"
enable = true

# Enable and add your API key if you have an NZBgeek account
[[indexers]]
name = "NZBgeek"
definitionName = "NZBgeek"
enable = false
fields = { apiKey = "your-nzbgeek-api-key" }

# ─── Usenet Providers (SABnzbd) ────────────────────────────────
# Fill in your provider details and set enable = true.
# Common providers:
#   Newshosting:    news.newshosting.com     port 563  ssl=true  connections=30
#   Eweka:          news.eweka.nl            port 563  ssl=true  connections=20
#   Frugal Usenet:  news.frugalusenet.com    port 563  ssl=true  connections=20
#   UsenetExpress:  news.usenetexpress.com   port 563  ssl=true  connections=20
#   Easynews:       news.easynews.com        port 563  ssl=true  connections=20

[[usenet_providers]]
name = "usenet"
enable = false
host = ""
port = 563
ssl = true
username = ""
password = ""
connections = 20

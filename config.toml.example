# ─── General ────────────────────────────────────────────────────
# Top-level keys must come before the first [section] in TOML

timezone = "America/New_York"

# ─── Credentials ─────────────────────────────────────────────────

[jellyfin]
username = "admin"
password = "changeme"

[qbittorrent]
username = "admin"
password = "changeme"

[downloads]
complete = "/downloads/torrents/complete"
incomplete = "/downloads/torrents/incomplete"
seeding_ratio = 2
seeding_time_minutes = 10080

[subtitles]
languages = ["en", "es"]
providers = [
  # No account needed
  "podnapisi",         # High quality, well-labeled
  "yifysubtitles",     # Great for movies
  "tvsubtitles",       # TV-focused provider
  "gestdown",          # Good general coverage
  "supersubtitles",    # Broad coverage
  "embeddedsubtitles", # Extracts subs already in the file
  # Account needed (configure in Bazarr UI)
  "opensubtitlescom",  # Largest database (free account at opensubtitles.com)
  "addic7ed",          # Curated TV subtitles (requires login)
  "subf2m",            # Subscene successor (requires user-agent in Bazarr)
]

# ─── Quality (Recyclarr TRaSH Guide profiles) ──────────────────
# Recyclarr creates these profiles and Jellyseerr requests use them.
# Sonarr: "WEB-1080p", "WEB-1080p (Alternative)", "WEB-2160p",
#         "WEB-2160p (Alternative)", "WEB-2160p (Combined)",
#         "Remux + WEB 1080p", "Remux + WEB 2160p",
#         "Remux 2160p (Alternative)", "Remux 2160p (Combined)"
# Sonarr anime: "[Anime] Remux-1080p"
# Radarr: "HD Bluray + WEB", "UHD Bluray + WEB", "Remux + WEB 1080p",
#         "Remux + WEB 2160p", "Remux 2160p (Alternative)",
#         "Remux 2160p (Combined)"

[quality]
sonarr_profile = "WEB-1080p"
sonarr_anime_profile = "[Anime] Remux-1080p"
radarr_profile = "HD Bluray + WEB"

# ─── Network ────────────────────────────────────────────────────
# admin_bind: address the admin UIs (Sonarr, Radarr, Prowlarr, Bazarr,
#   qBittorrent, SABnzbd, Tdarr, Dozzle, ...) listen on. "0.0.0.0" = every
#   interface (LAN + Tailscale); "127.0.0.1" = this machine only; or your
#   Tailscale IP to reach them only over Tailscale. Jellyfin, Jellyseerr,
#   Navidrome, Immich and the dashboard on port 80 are always reachable.
# docker_subnet: subnet for the containers. Change it only if it clashes
#   with a network you already use.

[network]
admin_bind = "0.0.0.0"
docker_subnet = "172.29.84.0/24"

# ─── Indexers (Prowlarr) ───────────────────────────────────────

[[indexers]]
name = "1337x"
definitionName = "1337x"
enable = true
flaresolverr = true

[[indexers]]
name = "EZTV"
definitionName = "eztv"
enable = true

[[indexers]]
name = "The Pirate Bay"
definitionName = "thepiratebay"
enable = true

[[indexers]]
name = "YTS"
definitionName = "yts"
enable = true

[[indexers]]
name = "Knaben"
definitionName = "Knaben"
enable = true

[[indexers]]
name = "LimeTorrents"
definitionName = "limetorrents"
enable = true

[[indexers]]
name = "Torrent Downloads"
definitionName = "torrentdownloads"
enable = true

[[indexers]]
name = "BitSearch"
definitionName = "bitsearch"
enable = true

[[indexers]]
name = "MegaPeer"
definitionName = "megapeer"
enable = true

[[indexers]]
name = "Nyaa.si"
definitionName = "nyaasi"
enable = true
anime = true

[[indexers]]
name = "SubsPlease"
definitionName = "SubsPlease"
enable = true
anime = true

[[indexers]]
name = "Mikan"
definitionName = "mikan"
enable = true
anime = true

[[indexers]]
name = "Bangumi Moe"
definitionName = "bangumi-moe"
enable = true
anime = true

# Enable and add your API key if you have an NZBgeek account
[[indexers]]
name = "NZBgeek"
definitionName = "NZBgeek"
enable = false
fields = { apiKey = "your-nzbgeek-api-key" }

# ─── VPN (Gluetun — routes torrent traffic through VPN) ───────
# Supports 30+ providers: Mullvad, ProtonVPN, NordVPN, Surfshark, etc.
# See https://github.com/qdm12/gluetun-wiki for provider-specific config

[vpn]
enable = false
provider = "mullvad"           # VPN provider name
type = "wireguard"             # "wireguard" or "openvpn"
wireguard_private_key = ""     # Your WireGuard private key
wireguard_addresses = ""       # Your WireGuard address (e.g., "10.x.x.x/32")
server_countries = ""          # Preferred server country (e.g., "Switzerland")

# ─── System Monitoring (Beszel) ────────────────────────────────
# After starting Beszel hub (http://localhost:8090), create an account,
# click "Add System", and paste the generated key below.

[beszel]
agent_key = ""

# ─── Usenet Providers (SABnzbd) ────────────────────────────────
# Fill in your provider details and set enable = true.
# Common providers:
#   Newshosting:    news.newshosting.com     port 563  ssl=true  connections=30
#   Eweka:          news.eweka.nl            port 563  ssl=true  connections=20
#   Frugal Usenet:  news.frugalusenet.com    port 563  ssl=true  connections=20
#   UsenetExpress:  news.usenetexpress.com   port 563  ssl=true  connections=20
#   Easynews:       news.easynews.com        port 563  ssl=true  connections=20

[[usenet_providers]]
name = "usenet"
enable = false
host = ""
port = 563
ssl = true
username = ""
password = ""
connections = 20
